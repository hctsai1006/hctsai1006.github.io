{
  "name": "hctsai-browser-workstation",
  "version": "2.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Browser-hosted PowerShell-compatible workstation. Versioned compatibility profiles over a semantic execution engine.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "truth:check": "node tools/verify-release-truth.mts --check",
    "truth:write": "node tools/verify-release-truth.mts --write",
    "truth:verify": "node tools/verify-release-truth.mts --offline",
    "roadmap": "node tools/generate-roadmap.mts",
    "check:numbers": "node tools/check-numbers.mts",
    "snapshot:authoritative": "node tools/check-numbers.mts --write-snapshot",
    "verify": "npm run check:engine && npm run typecheck && npm test && npm run data -- --check && npm run inventory -- --check && npm run manifests -- --check && npm run conformance -- --check && npm run profiles -- --check && npm run explorer -- --check && npm run roadmap -- --check && npm run check:numbers -- --require-authoritative && npm run check:bytes && npm run width -- --check && npm run truth:verify",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mts",
    "test:summary": "node tools/run-tests.mts --summary test-summary.json",
    "capture:metadata": "pwsh -NoProfile -File tools/capture-pwsh-metadata.ps1",
    "capture:culture": "pwsh -NoProfile -File tools/capture-pwsh-culture.ps1",
    "capture:conformance": "pwsh -NoProfile -File tools/generate-conformance-fixtures.ps1",
    "conformance": "node tools/conformance.mts",
    "profiles": "node tools/generate-compatibility-profile.mts",
    "explorer": "node tools/generate-compat-explorer.mts",
    "data": "node tools/extract-portfolio-data.mts",
    "inventory": "node tools/extract-command-inventory.mts",
    "manifests": "node tools/generate-command-manifests.mts",
    "check:bytes": "node tools/check-source-bytes.mts",
    "width": "node tools/generate-width-table.mts",
    "check:engine": "node tools/check-engine.mts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.2"
  }
}
